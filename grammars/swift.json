{
  "name": "Swift",
  "scopeName": "source.swift",
  "type": "tree-sitter",
  "parser": "tree-sitter-swift",
  "injectionNames": ["swift"],
  "fileTypes": ["swift", "swiftinterface"],
  "firstLineRegex": "^#![ \\t]*(?:/[^\\x0d\\x0a \\t]*/(?:swift(?:\\.exe)?)|/[^\\x0d\\x0a \\t]*/env(?:\\.exe)?[ \\t]+(?:-S[ \\t]+)?(?:swift(?:\\.exe)?))(?=[ \\t\\x0d\\x0a]|$)",
  "comments": {
    "start": "// "
  },
  "treeSitter": {
    // Pin a tag or a full SHA, never a branch. Verify the ref is on the main
    // line before trusting it — `gh api repos/OWNER/REPO/compare/<ref>...HEAD`
    // reporting `diverged` or a nonzero `behind` means it is not.
    "parserSource": "github:lumine-code/tree-sitter-swift#c3c28d2ffc6a02ba053e7c57fe71fc3eb774faa0",
    "wasmBuildTool": "tree-sitter-cli#v0.27.2",
    "grammar": "swift.wasm",
    "highlightsQuery": "swift-highlights.scm",
    "indentsQuery": "swift-indents.scm",
    "localsQuery": "swift-locals.scm",
    "foldsQuery": "swift-folds.scm",
    "tagsQuerySupportsLocalPath": true,
    "tagsQuery": "swift-tags.scm",
    "injectionsQuery": "swift-injections.scm"
  }
}
