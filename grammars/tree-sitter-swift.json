{
  "name": "Swift",
  "scopeName": "source.swift",
  "type": "tree-sitter",
  "parser": "tree-sitter-swift",
  "injectionRegex": "^(swift)$",
  "fileTypes": ["swift"],
  "comments": {
    "start": "/ "
  },
  "treeSitter": {
    // Pin a tag or a full SHA, never a branch. Verify the ref is on the main
    // line before trusting it — `gh api repos/OWNER/REPO/compare/<ref>...HEAD`
    // reporting `diverged` or a nonzero `behind` means it is not.
    "parserSource": "github:alex-pinkus/tree-sitter-swift#0.7.3",
    // REBUILD THIS ONE WITH `--regenerate`. Upstream's committed src/parser.c
    // was generated by tree-sitter-cli 0.26.11, which drops U+017F and U+212A
    // from its negated character sets, so a comment holding either one ends
    // there and the rest of the file stops parsing. A plain rebuild compiles
    // that parser.c as shipped and puts the bug straight back; regenerating
    // with the CLI below replaces it. Drop this note once upstream ships a
    // parser.c generated by anything other than 0.26.11.
    "wasmBuildTool": "tree-sitter-cli#v0.26.13",
    "grammar": "tree-sitter-swift/tree-sitter-swift.wasm",
    "highlightsQuery": "tree-sitter-swift/highlights.scm",
    "localsQuery": "tree-sitter-swift/locals.scm",
    "foldsQuery": "tree-sitter-swift/folds.scm",
    "tagsQuery": "tree-sitter-swift/tags.scm"
  }
}
